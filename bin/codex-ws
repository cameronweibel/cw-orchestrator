#!/usr/bin/env bash
# codex-ws: launch OpenAI Codex CLI with a workspace profile selected.
# The Codex twin of claude-ws. Same arguments, same workspaces, same layering.
# Usage:
#   codex-ws                          # interactive picker
#   codex-ws hebbian                  # positional
#   codex-ws -w convolving            # flag form
#   codex-ws hebbian -- resume        # any extra args forward to codex
#   codex-ws hebbian -- exec "job"    # headless agent job
#   codex-ws hebbian -- "do the job"  # interactive, seeded with a prompt
#
# Workspaces are discovered from $PROFILES_DIR/*.mcp.json, exactly as in
# claude-ws, so both launchers always see the same set. Each workspace gets a
# private CODEX_HOME under ~/.codex-ws/<name>, rebuilt on every launch from the
# profile json and the workspace CLAUDE.md. That private home is what keeps the
# Google accounts apart: it is the closest thing Codex has to
# --strict-mcp-config.
#
# Environment knobs:
#   CODEX_BIN           path to the codex binary, when it is not on PATH
#   CODEX_WS_SANDBOX    sandbox policy passed as --sandbox (default: codex's)
#   CODEX_WS_APPROVAL   approval policy passed as --ask-for-approval
set -euo pipefail

PROFILES_DIR="$HOME/.claude/profiles"
WORKSPACES_DIR="$HOME/.claude/workspaces"
SECRETS_FILE="$HOME/.claude/secrets.env"
GLOBAL_MD="$HOME/.claude/CLAUDE.md"
BASE_CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CODEX_HOMES_DIR="$HOME/.codex-ws"
BUILDER="$HOME/.claude/bin/codex-ws-profile.py"

# Codex ships inside the ChatGPT desktop app, so it is often not on PATH.
find_codex() {
  if [[ -n "${CODEX_BIN:-}" ]]; then echo "$CODEX_BIN"; return 0; fi
  if command -v codex >/dev/null 2>&1; then command -v codex; return 0; fi
  local bundled="/Applications/ChatGPT.app/Contents/Resources/codex"
  [[ -x "$bundled" ]] && { echo "$bundled"; return 0; }
  echo "codex-ws: no codex binary found, set CODEX_BIN" >&2
  return 1
}
CODEX="$(find_codex)"

# Load shared secrets (OAuth client id/secret etc.) if present.
# This file is sourced as bash, so it should contain `export FOO=...` lines.
if [[ -f "$SECRETS_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$SECRETS_FILE"
fi

# Discover workspaces from the profiles directory.
workspaces=()
for f in "$PROFILES_DIR"/*.mcp.json; do
  [[ -e "$f" ]] || continue
  b="$(basename "$f")"
  workspaces+=("${b%.mcp.json}")
done
if [[ ${#workspaces[@]} -eq 0 ]]; then
  echo "codex-ws: no profiles found in $PROFILES_DIR" >&2
  exit 1
fi

# Resolve a name or unique prefix against the discovered workspaces.
resolve_ws() {
  local q="$1" hit="" w
  for w in "${workspaces[@]}"; do
    [[ "$w" == "$q" ]] && { echo "$w"; return 0; }
  done
  for w in "${workspaces[@]}"; do
    if [[ "$w" == "$q"* ]]; then
      if [[ -n "$hit" ]]; then
        echo "codex-ws: '$q' is ambiguous ($hit, $w)" >&2
        return 1
      fi
      hit="$w"
    fi
  done
  [[ -n "$hit" ]] && { echo "$hit"; return 0; }
  echo "codex-ws: no workspace matching '$q'" >&2
  echo "Available workspaces:" >&2
  printf '  %s\n' "${workspaces[@]}" >&2
  return 1
}

ws=""
case "${1:-}" in
  -w|--workspace)
    [[ $# -ge 2 ]] || { echo "codex-ws: --workspace requires a value" >&2; exit 1; }
    ws="$(resolve_ws "$2")"
    shift 2
    ;;
  "" )
    PS3="Select workspace: "
    select c in "${workspaces[@]}"; do
      [[ -n "${c:-}" ]] && { ws="$c"; break; }
    done
    ;;
  *)
    ws="$(resolve_ws "$1")"
    shift
    ;;
esac

profile="$PROFILES_DIR/${ws}.mcp.json"

# Drop the optional `--` separator so flags after it reach codex as flags.
if [[ "${1:-}" == "--" ]]; then shift; fi

# Per-workspace home: operating folder, env, and layered context.
ws_dir="$WORKSPACES_DIR/$ws"
[[ -d "$ws_dir" ]] || ws_dir="$HOME"
export CLAUDE_WORKSPACE="$ws"
export CLAUDE_WORKSPACE_DIR="$ws_dir"
export CODEX_WORKSPACE="$ws"

# workspace.env pins per-workspace settings (e.g. GOOGLE_DRIVE_FOLDER_ID).
if [[ -f "$ws_dir/workspace.env" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "$ws_dir/workspace.env"
  set +a
fi

# Rebuild the workspace CODEX_HOME: config.toml with this workspace's MCP
# servers, AGENTS.md with the global plus workspace instructions, and links
# back to the real ~/.codex for auth, plugins and caches.
mkdir -p "$CODEX_HOMES_DIR"
# The builder prints one `key=value` config override per line. They carry the
# settings that have to differ per launch rather than per workspace, so that
# two sessions in the same workspace never race on the config file.
overrides=()
while IFS= read -r line; do
  [[ -n "$line" ]] && overrides+=(-c "$line")
done < <(python3 "$BUILDER" "$ws" "$ws_dir" "$profile" \
  "$BASE_CODEX_HOME" "$CODEX_HOMES_DIR/$ws" "$GLOBAL_MD")
export CODEX_HOME="$CODEX_HOMES_DIR/$ws"

extra_args=("${overrides[@]+"${overrides[@]}"}")
[[ -n "${CODEX_WS_SANDBOX:-}" ]]  && extra_args+=(--sandbox "$CODEX_WS_SANDBOX")
[[ -n "${CODEX_WS_APPROVAL:-}" ]] && extra_args+=(--ask-for-approval "$CODEX_WS_APPROVAL")

# `codex exec` refuses to start outside a git repo unless told otherwise, and
# a workspace folder is not one. Trusting the folder in config.toml is not
# enough, so pass the flag for headless runs.
if [[ "${1:-}" == "exec" || "${1:-}" == "e" ]]; then
  sub="$1"; shift
  set -- "$sub" --skip-git-repo-check "$@"
fi

exec "$CODEX" "${extra_args[@]+"${extra_args[@]}"}" "$@"
